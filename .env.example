# Live demo model (Groq free tier). Put the real key in .env (gitignored), never in code.
GROQ_API_KEY=
# Optional: which model the API uses. Default: groq:qwen/qwen3.8-27b if GROQ_API_KEY is set, else qwen3:4b via Ollama.
# Examples: GUARD_MODEL=groq:qwen/qwen3.8-27b   GUARD_MODEL=qwen3:4b   GUARD_MODEL=mock
GUARD_MODEL=
# Local model for the eval (Ollama)
OLLAMA_URL=http://localhost:11434
# Set to 1 to regenerate results from eval/cache/*.jsonl without calling any model.
EVAL_OFFLINE=0
